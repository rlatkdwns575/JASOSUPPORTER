# JasoSupporter FastAPI 백엔드 환경 변수 예시
# 이 파일을 복사해 backend/.env 로 저장하고 실제 값을 채우세요.
# .env 는 절대 커밋하지 마세요.

# --- Gemini (필수) ---
GOOGLE_API_KEY=여기에_Gemini_API_키
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ALLOWED_MODELS=gemini-3.6-flash,gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# --- Pinecone (선택: 없으면 로컬 저장소 기반 폴백으로 RAG 동작) ---
PINECONE_API_KEY=여기에_Pinecone_API_키
PINECONE_INDEX=jaso-supporter
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- 앱 설정 ---
DEFAULT_USER_ID=default
# SQLite(개발) 또는 Postgres(배포)
# DATABASE_URL=sqlite:///./jaso_supporter.db
# DATABASE_URL=postgresql+psycopg://jaso:jaso@localhost:5432/jaso_supporter
DATABASE_URL=sqlite:///./jaso_supporter.db
CORS_ORIGINS=*
RAG_TOP_K=5
LOG_LEVEL=INFO

# --- Auth (JWT) ---
JWT_SECRET=반드시_긴_랜덤_문자열로_교체
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# 프로덕션에서는 true 권장. false 면 X-User-Id soft identity 폴백 허용.
AUTH_REQUIRED=false
