# JasoSupporter FastAPI 백엔드 환경 변수 예시
# 이 파일을 복사해 backend/.env 로 저장하세요. .env 는 커밋하지 마세요.

# --- LLM (로컬 Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11435
# 기본 Ollama는 11434. GTX 등 CUDA PTX 오류 시 11435(CPU/Vulkan) serve 권장.
OLLAMA_MODEL=jaso-coach
OLLAMA_ALLOWED_MODELS=jaso-coach,qwen3:1.7b
OLLAMA_TIMEOUT_SEC=300

# --- 앱 설정 ---
DEFAULT_USER_ID=default
DATABASE_URL=sqlite:///./jaso_supporter.db
CORS_ORIGINS=*
# 선택 경험이 없을 때 최근 Experience 폴백 개수
RAG_TOP_K=5
LOG_LEVEL=INFO

# --- Auth (JWT) ---
JWT_SECRET=반드시_긴_랜덤_문자열로_교체
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_REQUIRED=false
